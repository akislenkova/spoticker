# Required for analyze_workload (pipeline stages 2 and 4)
ANTHROPIC_API_KEY=sk-ant-...

# Required for all tools (spot price database)
SUPABASE_URL=https://xxxx.supabase.co
# Preferred: anon/public key + an RLS SELECT policy on the spot-price tables.
# This server only ever reads price data, so it never needs service_role.
SUPABASE_KEY=eyJ...anon...
# Fallback only — bypasses RLS entirely. Prefer SUPABASE_KEY above.
# SUPABASE_SERVICE_KEY=eyJ...service_role...

# Optional: restrict which local AWS profiles get_spot_placement_score may
# use, e.g. "default,staging". Omit to allow any profile (default behavior).
# SPOTICKER_ALLOWED_AWS_PROFILES=default
