# Anthropic API key — required for Stage 2 (infer) and Stage 4 (rewrite)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# Preferred: SUPABASE_KEY = anon/public key, with an RLS policy on the
# spot-price tables (latest_aws_spot_prices, spot_bid_advisor,
# latest_azure_spot_prices, azure_spot_eviction_rates, gcp_spot_prices)
# granting SELECT to anon/authenticated. This service only ever reads
# those tables, so it never needs the service_role key.
SUPABASE_KEY=eyJ...anon...
# Fallback only — bypasses RLS entirely. Use SUPABASE_KEY above instead
# once RLS read policies are in place.
# SUPABASE_SERVICE_KEY=eyJ...service_role...
